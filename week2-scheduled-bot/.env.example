# Telegram token from @BotFather
TELEGRAM_TOKEN=

# Discord token from the Developer Portal (Bot -> Token)
DISCORD_TOKEN=

# Slack: bot token (xoxb-) + app-level token (xapp-, scope connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Reddit "script" app credentials (reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=week2-scheduled-bot/0.2 by u/YOUR_USERNAME

# Comma-separated admin identities: "telegram:123456,discord:7890"
ADMIN_IDS=

# SQLite file path
DB_PATH=bot.db

# Per-user rate limit: burst of N commands, then 1 per WINDOW seconds
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_WINDOW_S=10

# Week 2: API keys (optional - many APIs work without keys)
# Weather API - wttr.in is free and doesn't require a key
# Crypto API - CoinGecko free tier doesn't require a key
# If you want to use other APIs, add keys here:
# WEATHER_API_KEY=
# CRYPTO_API_KEY=

# Week 2: Job scheduler settings
JOBS_ENABLED=true
JOBS_TIMEZONE=UTC
